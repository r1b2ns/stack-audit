CREATE TABLE audit_event (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    id TEXT NOT NULL UNIQUE,
    timestamp INTEGER NOT NULL,
    duration INTEGER,
    category TEXT NOT NULL,
    source TEXT NOT NULL,
    trace_id TEXT,
    title TEXT NOT NULL,
    payload TEXT NOT NULL,
    size INTEGER NOT NULL,
    prev_hash TEXT,
    hash TEXT NOT NULL
);

CREATE INDEX audit_event_time ON audit_event(timestamp);
CREATE INDEX audit_event_category ON audit_event(category, seq);

CREATE TABLE audit_http (
    event_seq INTEGER NOT NULL PRIMARY KEY,
    method TEXT NOT NULL,
    host TEXT NOT NULL,
    status INTEGER,
    request_hash TEXT,
    response_hash TEXT,
    request_size INTEGER,
    response_size INTEGER
);

CREATE TABLE audit_ref (
    event_seq INTEGER NOT NULL,
    hash TEXT NOT NULL
);

CREATE INDEX audit_ref_hash ON audit_ref(hash);
CREATE INDEX audit_ref_seq ON audit_ref(event_seq);

CREATE TABLE audit_blob (
    hash TEXT NOT NULL PRIMARY KEY,
    data BLOB NOT NULL,
    size INTEGER NOT NULL
);

CREATE TABLE audit_flag_override (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE audit_setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE audit_nonce (
    nonce TEXT NOT NULL PRIMARY KEY,
    expires_at INTEGER NOT NULL
);

CREATE TABLE audit_secret (
    event_seq INTEGER NOT NULL PRIMARY KEY,
    data BLOB NOT NULL
);

insertEvent:
INSERT INTO audit_event(id, timestamp, duration, category, source, trace_id, title, payload, size, prev_hash, hash)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastSeq:
SELECT last_insert_rowid();

insertHttp:
INSERT INTO audit_http(event_seq, method, host, status, request_hash, response_hash, request_size, response_size) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRef:
INSERT INTO audit_ref(event_seq, hash) VALUES (?, ?);

deleteRefsUpTo:
DELETE FROM audit_ref WHERE event_seq <= ?;

deleteAllRefs:
DELETE FROM audit_ref;

insertBlob:
INSERT OR IGNORE INTO audit_blob(hash, data, size) VALUES (?, ?, ?);

blob:
SELECT data FROM audit_blob WHERE hash = ?;

lastHash:
SELECT hash FROM audit_event ORDER BY seq DESC LIMIT 1;

summaries:
SELECT e.id, e.timestamp, e.duration, e.category, e.source, e.title, h.method, h.host, h.status, h.request_size, h.response_size
FROM audit_event e LEFT JOIN audit_http h ON h.event_seq = e.seq
WHERE (:category IS NULL OR e.category = :category)
  AND (:query IS NULL OR e.title LIKE '%' || :query || '%')
ORDER BY e.seq DESC
LIMIT :limit;

eventById:
SELECT * FROM audit_event WHERE id = ?;

allEvents:
SELECT * FROM audit_event ORDER BY seq;

eventsByCategory:
SELECT * FROM audit_event WHERE category = ? ORDER BY seq;

lastSeqBefore:
SELECT MAX(seq) FROM audit_event WHERE timestamp < ?;

seqAtOffset:
SELECT seq FROM audit_event ORDER BY seq LIMIT 1 OFFSET ?;

countEvents:
SELECT COUNT(*) FROM audit_event;

oldestTimestamp:
SELECT MIN(timestamp) AS oldest FROM audit_event;

deleteUpTo:
DELETE FROM audit_event WHERE seq <= ?;

deleteHttpUpTo:
DELETE FROM audit_http WHERE event_seq <= ?;

deleteOrphanBlobs:
DELETE FROM audit_blob WHERE hash NOT IN (SELECT hash FROM audit_ref);

eventBytes:
SELECT COALESCE(SUM(size), 0) FROM audit_event;

blobBytes:
SELECT COALESCE(SUM(size), 0) FROM audit_blob;

deleteAllEvents:
DELETE FROM audit_event;

deleteAllHttp:
DELETE FROM audit_http;

deleteAllBlobs:
DELETE FROM audit_blob;

flagOverrides:
SELECT key, value FROM audit_flag_override;

saveFlagOverride:
INSERT OR REPLACE INTO audit_flag_override(key, value) VALUES (?, ?);

deleteFlagOverride:
DELETE FROM audit_flag_override WHERE key = ?;

setting:
SELECT value FROM audit_setting WHERE key = ?;

saveSetting:
INSERT OR REPLACE INTO audit_setting(key, value) VALUES (?, ?);

nonceCount:
SELECT COUNT(*) FROM audit_nonce WHERE nonce = ?;

saveNonce:
INSERT OR REPLACE INTO audit_nonce(nonce, expires_at) VALUES (?, ?);

deleteExpiredNonces:
DELETE FROM audit_nonce WHERE expires_at < ?;

insertSecret:
INSERT OR REPLACE INTO audit_secret(event_seq, data) VALUES (?, ?);

secretById:
SELECT s.data FROM audit_secret s JOIN audit_event e ON e.seq = s.event_seq WHERE e.id = ?;

deleteSecretsUpTo:
DELETE FROM audit_secret WHERE event_seq <= ?;

deleteAllSecrets:
DELETE FROM audit_secret;
